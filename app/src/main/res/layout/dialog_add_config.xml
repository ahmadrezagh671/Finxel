<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAddConfig"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="32dp"
    app:cardCornerRadius="28dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardElevation="4dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <TextView
            android:textAlignment="center"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_configuration"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/select_method_to_import_config"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:textAlignment="center"
            android:layout_gravity="center_horizontal" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            app:dividerColor="?attr/colorOutlineVariant"
            app:dividerInsetStart="0dp"
            app:dividerInsetEnd="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            >

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddConfigGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:icon="@drawable/ic_github"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:cornerRadius="16dp"
                app:strokeWidth="0dp"
                android:text="@string/add_config_from_github"
                android:textAlignment="center"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddConfigFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cornerRadius="16dp"
                    app:strokeWidth="0dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="?attr/colorPrimaryFixed"
                    android:text="@string/from_files"
                    android:textColor="?attr/colorOnPrimaryFixed"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddConfigClipboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cornerRadius="16dp"
                    app:strokeWidth="0dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="?attr/colorPrimaryFixed"
                    android:text="@string/from_clipboard"
                    android:textColor="?attr/colorOnPrimaryFixed"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/need_help_read_documentation"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:textStyle="normal"
            android:textAlignment="center"
            />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
