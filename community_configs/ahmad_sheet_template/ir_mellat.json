    {
      "name":"description_entry",
      "hint":"Description"
    }
  ],
  "compare_with_last_message":[
    {
      "name":"Balance Check",
      "field":"balance_before_transaction",
      "last_message_field":"balance",
      "error_text":"Balance Mismatch: "
    }
  ],
  "spinner_list": [
    {
      "name": "ACTION",
      "value": [
        "Entertainment",
        "Expenses",
        "Income",
        "Alex",
        "Dad",
        "Sis"
      ]
    }
  ],
  "skips": [
    {
      "type": "CONTAINS",
      "action": "رمز پویا",
      "error_text": "This is a password message, not a transaction."
    },
    {
      "type": "NOT_CONTAINS",
      "action": "حساب",
      "error_text": "No Mellat Bank transaction found."
    },
    {
      "type": "CONTAINS",
      "action": "یارانه",
      "error_text": "This is a subsidy message, not a transaction."
    }
  ],
  "fields_before_click":[
    {
      "name": "10000",
      "type": "TEXT",
      "text": "10000"
    },
    {
      "name": "amount",
      "type": "REGEX_FIND_SMS_BODY",
      "regex": "(برداشت|واریز)[0-9]+",
      "group": 0,
      "replacements_after": [
        {
          "find": "برداشت",
          "replace": "-"
        },
        {
          "find": "واریز",
          "replace": "+"
        }
      ],
      "replacements_before": [
        {
          "find": ",",
          "replace": ""
        }
      ]
    },
    {
      "name":"balanceAmount",
      "type":"REGEX_FIND_SMS_BODY",
      "regex":"مانده(\\d+)",
      "group": 1,
      "replacements_before": [
        {
          "find": ",",
          "replace": ""
        }
      ]
    },
    {
      "name": "balance",
      "type": "MATH_OPERATION",
      "operator": "/",
      "fields": [
        "balanceAmount",
        "10000"
      ]
    },
    {
      "name": "amount_divided_by_10000",
      "type": "MATH_OPERATION",
      "operator": "/",
      "fields": [
        "amount",
        "10000"
      ]
    },
    {
      "name": "balance_before_transaction",
      "type":"MATH_OPERATION",
      "operator": "-",
      "fields": [
        "balance",
        "amount_divided_by_10000"
      ]
    }
  ],
  "fields": [
    {
      "name": "time",
      "type": "REGEX_FIND_SMS_BODY",
      "regex": "\\d{2}/\\d{2}/(\\d{2}-\\d{2}:\\d{2})",
      "group": 1,
      "replacements_after": [
        {
          "find": "-",
          "replace": " "
        }
      ]
    },
    {
      "name": "date_without_century",
      "type": "REGEX_FIND_SMS_BODY",
      "regex": "(\\d{2}\/\\d{2})(?=\/\\d{2}-)",
      "replacements_after": [
        {
          "find": "/",
          "replace": "-"
        }
      ]
    },
    {
      "name": "century",
      "type": "TEXT",
      "text": "14"
    },
    {
      "name":"date",
      "type":"COMBINE_FIELDS",
      "fields":[
        "century",
        "date_without_century"
      ]
    },
    {
      "name": "description",
      "type": "NOTIFICATION_ENTRY_DATA",
      "key": "description_entry"
    },
    {
      "name": "bank_name",
      "type": "TEXT",
      "text": "Mellat"
    },
    {
      "name": "layout_text",
      "type": "TEXT",
      "text": "Enter your Mellat Bank transaction details."
    },
    {
      "name": "locationLatitude",
      "type": "L_LATITUDE"
    },
    {
      "name": "locationLongitude",
      "type": "L_LONGITUDE"
    },
    {
      "name":"comma",
      "type":"TEXT",
      "text":","
    },
    {
      "name":"locationStartText",
      "type":"TEXT",
      "text":"=HYPERLINK(\"https://maps.google.com/maps?q=loc:"
    },
    {
      "name":"locationEndText",
      "type":"TEXT",
      "text":"\", \"Location\")"
    },
    {
      "name":"locationLink",
      "type":"COMBINE_FIELDS",
      "fields":[
        "locationStartText",
        "locationLatitude",
        "comma",
        "locationLongitude",
        "locationEndText"
      ],
      "replacements_after": [
        {
          "find": "=HYPERLINK(\"https://maps.google.com/maps?q=loc:,\", \"Location\")",
          "replace": "No Location"
        }
      ]
    }
